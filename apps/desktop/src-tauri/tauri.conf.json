{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Umi",
  "version": "0.2.9",
  "identifier": "cam.umi.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Umi",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#F1F7FC",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "signingIdentity": "Apple Development: Huseyin Sezer Yildirim (8UJRUX76H4)",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBMzU4OEFERTdGRDdCMUEKUldRYWUvM25yWWcxaXVxNXlqZDJlU3F5L0wvekhrdEREUEtBRThUYUlIZTlSQzFXVTZHWnowOW4K",
      "endpoints": [
        "https://github.com/huseyinsezeryildirim/umi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
