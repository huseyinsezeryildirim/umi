{
  "name": "@umi/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "build:demo": "VITE_DEMO=1 vite build --base /demo/ --outDir ../site/public/demo --emptyOutDir",
    "build:web": "VITE_WEB=1 vite build --base /editor/ --outDir ../site/public/editor --emptyOutDir",
    "wasm": "cd ../.. && cargo build -p umi-web --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir apps/desktop/src/web/pkg target/wasm32-unknown-unknown/release/umi_web.wasm",
    "build:mac": "tauri build --bundles app && python3 scripts/bundle-libs.py"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@umi/ui": "workspace:*",
    "kokoro-js": "^1.2.1",
    "lucide-solid": "^1.61.0",
    "mediabunny": "^1.62.1",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
